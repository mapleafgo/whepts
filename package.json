{
  "name": "whepts",
  "type": "module",
  "version": "1.2.0-next.0",
  "packageManager": "pnpm@10.28.2",
  "description": "基于 mediamtx 的 WebRTC WHEP 播放器，支持 ZLM 和 Mediamtx 的播放地址",
  "author": "mapleafgo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/mapleafgo/whepts.git"
  },
  "keywords": [
    "webrtc",
    "whep",
    "player",
    "streaming",
    "mediamtx",
    "zlmediakit",
    "typescript",
    "video",
    "audio",
    "realtime",
    "low-latency",
    "media"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "npm run build",
    "test": "npm run build && node --test tests/*.test.mjs",
    "build": "rollup --config --environment NODE_ENV:production",
    "build:debug": "rollup --config",
    "lint": "oxlint src tests",
    "lint:fix": "oxlint --fix src tests",
    "format": "oxfmt src tests",
    "format:check": "oxfmt --check src tests"
  },
  "dependencies": {
    "eventemitter3": "^5.0.4",
    "nanostores": "^1.1.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^25.0.10",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "rollup": "^4.56.0",
    "rollup-plugin-delete": "^3.0.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  }
}